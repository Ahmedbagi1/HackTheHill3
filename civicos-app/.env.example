# Copy to .env.local and fill in. These are read by the Vite dev/preview server
# only (see server/elevenLabsProxy.js) and are never bundled into the browser.

# Without a key, the voice companion falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=

# Optional overrides
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
