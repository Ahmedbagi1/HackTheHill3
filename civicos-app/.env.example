# Copy to .env.local and fill in. Never put real values in this example.

# Public Auth0 SPA identifiers, bundled into the browser by Vite.
# Never add a Client Secret to frontend configuration.
VITE_AUTH0_DOMAIN=your-auth0-domain
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# Public Supabase configuration for the Auth0-backed application client.
# Never use a secret/service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Set the same public variables in the hosting provider's build environment.
# Auth0 login/logout URLs use window.location.origin; no redirect URL variable is needed.

# The variables below are read only by the Vite dev/preview server
# (see server/elevenLabsProxy.js) and never bundled into the browser.

# Without a key, the voice companion falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=

# Optional overrides
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google Gemini (Smart Triage, AI Explain, Quick Auto-Fill). Server-side only:
# do NOT prefix with VITE_, which would bundle the key into the browser.
# Vercel: set this in the Node.js function's runtime environment. See docs/GEMINI.md.
# Without a key, the app falls back to keyword search and manual entry.
GEMINI_API_KEY=
